# Copie para ".env" e preencha (NUNCA suba o .env para o Git).
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
# E-mail(s) de quem pode usar o painel admin, separados por vírgula (IMPORTANTE)
ADMIN_EMAILS=
# Google Calendar API (function calendar.js) — chave do Google, fica SÓ aqui
API_KEY=
# Opcional: ID da agenda (reserva — o painel, aba Agenda, tem prioridade)
CALENDAR_ID=
# Data de nascimento AAAA-MM-DD (function idade.js) — reserva: o painel admin tem prioridade
IDADE_NASC=
# Canal do YouTube — RESERVA: o painel (aba Redes sociais > Origem dos vídeos) tem prioridade
YOUTUBE_ID=
# RSS do TikTok, opcional — RESERVA: o painel tem prioridade
TIKTOK_URL_RSS=
# Opcional: chave do Odesli/song.link (function musica-buscar.js). Sem ela, a busca usa Deezer + Apple Music.
ODESLI_API_KEY=
# Curtidas (recurso reversível): 1 = desliga a contagem no servidor
CURTIDAS_DESATIVADAS=
# Máximo de gravações de curtidas por dia (padrão 3000)
CURTIDAS_LIMITE_DIA=
# Opcional: texto secreto para embaralhar o código de conexão
CURTIDAS_SAL=
