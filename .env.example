# Copie para ".env" e preencha (NUNCA suba o .env para o Git).
NETLIFY_SITE_ID=
NETLIFY_AUTH_TOKEN=
# Google Calendar API (function calendar.js)
API_KEY=
# Data de nascimento AAAA-MM-DD (function idade.js) — reserva: o painel admin tem prioridade
IDADE_NASC=
# Canal do YouTube (function feeds-update.js)
YOUTUBE_ID=
# RSS do TikTok, opcional (function feeds-update.js)
TIKTOK_URL_RSS=
# Opcional: chave do Odesli/song.link (function musica-buscar.js). Sem ela, a busca usa Deezer + Apple Music.
ODESLI_API_KEY=
